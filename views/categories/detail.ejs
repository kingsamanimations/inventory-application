<!-- This includes the header and footer from partials folder -->
<%- include("../partials/header") %>

    <% if (typeof error !== "undefined") { %>
        <p style="color: red;"><%= error %></p>
    <% } %>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <h1 class="mb-0"><%= category.name %></h1>
        <p><%= category.description %></p>
        <h2>Items</h2>
        <ul>
            <% items.forEach(function(item) { %>
                <li><%= item.name %> - <%= item.price %> (<%= item.quantity %> in stock)</li>
            <% }); %>
        </ul>
        <a href="/categories/<%= category.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit category</a>
    </div>
    <form action="/categories/<%= category.id %>/delete" class="card border-danger" method="post">
        <div class="card-body">
            <label class="form-label">
                Admin password:
                <div class="row g-2">
                    <div class="col-sm">
                        <input type="password" name="admin_password" required>
                    </div>
                </div>
            </label>
            <button type="submit">Delete this category</button>
        </div>
    </form>
<%- include("../partials/footer") %>