<!-- This includes the header and footer from partials folder -->
<%- include("../partials/header") %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0">Items</h1>
    <a href="/items/new"class="btn btn-primary">Add an item</a>
    <% if (items.length === 0) { %>
        <div class="alert alert-info">No items yet.</div>
    <% } else { %>
        <div class="">
            <ul>
                <% items.forEach(function(item) { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 card-title">
                                    <li>
                                        <a href="/items/<%= item.id %>"><%= item.name %></a>
                                    </li>
                                </h2>
                                <p class="card-text text-muted small flex-grow-1">
                                    - <%= item.description || "No description " %>
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">$<%= item.price %></span>
                                    <span class="badge text-bg-light"><%= item.category_name %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </ul>
        </div>
    <% } %> 
</div>
<%- include("../partials/footer") %>