<!-- This includes the header and footer from partials folder -->
<%- include("../partials/header") %>
<div class="card">
    <div class="card-body">
        <h1 class="h4 mb-4"><%= title %></h1>

        <% if (errors.length > 0) { %> 
            <ul style="color: red;">
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }); %>
            </ul>
        <% } %>

        <!-- Actual form-->
        <form method="post">
            <div class="mb-3">
                <label class="form-label">
                    Name:
                    <input type="text" name="name" value="<%= item.name || '' %>" required>
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label">
                    Description:
                    <textarea name="description"><%= item.description || '' %></textarea>
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label">
                    Price:
                    <input type="number" name="price" step="0.01" min="0" value="<%= item.price || '' %>" required>
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label">
                    Quantity:
                    <input type="number" name="quantity" min="0" value="<%= item.quantity || 0 %>" required>
                </label>
            </div>

            <label>
                Category:
                <select name="category_id" required>
                    <option value="">-- Choose --</option>
                    <% categories.forEach((c) => { %> 
                        <option value="<%= c.id %>"<%= Number(item.category_id) === c.id ? "selected" : "" %>>
                            <%= c.name %>
                        </option>
                    <% }); %>
                </select>
            </label>
            <div class="mb-3">
                <label class="form-label">
                    Admin password:
                    <input type="password" name="admin_password" required>
                </label>
            </div>
            <button type="submit">Delete this item</button>

            <button type="submit">Save</button>
        </form>

    </div>
</div>
<%- include("../partials/footer") %>